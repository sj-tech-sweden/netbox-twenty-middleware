# NetBox Test Environment Configuration
# Based on official netbox-docker env/netbox.env

DB_HOST=postgres-netbox
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=netbox_test_pass

REDIS_HOST=valkey-netbox
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_SSL=false
REDIS_INSECURE_SKIP_TLS_VERIFY=false

REDIS_CACHE_HOST=valkey-netbox-cache
REDIS_CACHE_PASSWORD=
REDIS_CACHE_DATABASE=1
REDIS_CACHE_SSL=false
REDIS_CACHE_INSECURE_SKIP_TLS_VERIFY=false

SECRET_KEY=netbox-test-secret-key-change-in-production-abcdef1234567890abcdef1234567890
SKIP_SUPERUSER=true
WEBHOOKS_ENABLED=true
MEDIA_ROOT=/opt/netbox/netbox/media
GRAPHQL_ENABLED=true
API_TOKEN_PEPPER_1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

EMAIL_SERVER=localhost
EMAIL_PORT=25
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=netbox@localhost
EMAIL_USE_SSL=false
EMAIL_USE_TLS=false
