{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "group:allNonMajor"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "groupName": "Docker actions",
      "matchPackageNames": [
        "docker/{/,}**"
      ]
    },
    {
      "groupName": "Python dependencies",
      "matchPackageNames": [
        "python{/,}**"
      ]
    }
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/docker-compose\\.yml$/"
    ]
  },
  "postUpdateOptions": ["pipCompileDocker"]
}
