# ═══════════════════════════════════════════════════════════════
# NetBox-Twenty Middleware - Test Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.test and fill in the values.
# The setup script (tests/setup-test-env.sh) will generate
# most of these values automatically.
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# NetBox Configuration
# ───────────────────────────────────────────────────────────────
# URL for the NetBox API (internal Docker network)
# Note: The NetBox Docker image listens on port 8080 internally.
NETBOX_URL=http://netbox:8080

# User-facing NetBox URL for deep links stored in Twenty (host the user browses)
NETBOX_PUBLIC_URL=http://localhost:8100

# API token for NetBox (auto-generated by setup script)
# NetBox v4.7+ uses hashed v2 tokens with the format:
#   nbt_<12-char-key>.<40-char-secret>
# Example: nbt_7Qay5Nntfmgc.ik25XnTsgDyUcZHnQmDovejMlR6Sxo9kWXvRcsTS
NETBOX_TOKEN=

# ───────────────────────────────────────────────────────────────
# Twenty CRM Configuration
# ───────────────────────────────────────────────────────────────
# URL for the Twenty API (internal Docker network)
TWENTY_URL=http://twenty-server:3000

# User-facing Twenty URL for deep links stored in NetBox (host the user browses)
TWENTY_PUBLIC_URL=http://localhost:3100

# API key for Twenty (set after Twenty first-time setup)
# Get from: Twenty UI > Settings > API Keys > Create API Key
TWENTY_API_KEY=

# ───────────────────────────────────────────────────────────────
# Valkey (Message Queue) Configuration
# ───────────────────────────────────────────────────────────────
VALKEY_HOST=valkey
VALKEY_PORT=6379

# ───────────────────────────────────────────────────────────────
# Webhook Configuration
# ───────────────────────────────────────────────────────────────
# Publicly reachable URL for webhook registrations
# This is the URL NetBox/Twenty will call back when firing webhooks.
# Inside the Docker test network, both NetBox and Twenty must reach the
# middleware via its service name on the INTERNAL port (8000), NOT
# localhost:8001 (which would resolve to the container firing the webhook).
PUBLIC_BASE_URL=https://host.docker.internal:8443

# ───────────────────────────────────────────────────────────────
# Webhook Secrets (Optional - auto-generated if omitted)
# ───────────────────────────────────────────────────────────────
# HMAC secret for NetBox webhook signature verification
# NETBOX_WEBHOOK_SECRET=

# Bearer token for Twenty webhook authentication
# TWENTY_WEBHOOK_TOKEN=
